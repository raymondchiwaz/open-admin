{
  "name": "open-admin",
  "version": "1.0.0",
  "description": "Open Admin — an open-source, plugin-first admin panel you can embed into any site. Everything on it (pages, widgets, themes, even the dashboard itself) is a plugin.",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "open-admin": "bin/open-admin.js"
  },
  "files": [
    "src",
    "public",
    "bin",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/open-admin.js",
    "demo": "node examples/demo-site.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "admin",
    "admin-panel",
    "dashboard",
    "plugin",
    "plugin-architecture",
    "open-source",
    "social-admin",
    "embeddable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymondchiwaz/open-admin.git"
  },
  "bugs": {
    "url": "https://github.com/raymondchiwaz/open-admin/issues"
  },
  "homepage": "https://github.com/raymondchiwaz/open-admin#readme"
}
